{
  "name": "@xielc/skillhub",
  "version": "1.0.0",
  "private": true,
  "description": "SkillHub AI Resource Platform - Enterprise-grade AI skills and prompts management platform",
  "main": "backend/dist/server.js",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently -n backend,frontend -c blue,green \"cd backend && npm run dev\" \"cd frontend && npm run dev\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:all": "npm run build && npm run build:backend",
    "start": "cross-env NODE_ENV=production node backend/dist/server.js",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "test": "cd backend && npm test",
    "test:frontend": "cd frontend && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  },
  "keywords": [
    "skillhub",
    "ai",
    "skills",
    "prompts",
    "agent",
    "llm",
    "gpt",
    "claude",
    "mcp"
  ],
  "author": "longchuanxie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/longchuanxie/skill-hub"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/longchuanxie/skill-hub/issues"
  },
  "homepage": "https://github.com/longchuanxie/skill-hub#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.4.2"
  }
}
