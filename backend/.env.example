# =============================================================================
# SkillHub Backend - Environment Configuration
# Copy this file to `.env` and adjust values. dotenv loads ONLY `.env`.
# =============================================================================

# Server
NODE_ENV=development
PORT=3001
# Comma-separated origins are NOT supported; see src/app.ts
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/skillhub

# JWT — both secrets are REQUIRED in production (the server refuses to start
# without them). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# SMTP (email sending) — used by email.ts and adminInvitationController.
# Legacy EMAIL_USER / EMAIL_PASS are still read as fallbacks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=SkillHub

# Frontend URL (invitation links, OAuth redirects)
FRONTEND_URL=http://localhost:5173
# Public base URL used to build OAuth callback addresses
OAUTH_CALLBACK_BASE_URL=http://localhost:3001

# Storage (local filesystem)
STORAGE_LOCAL_PATH=./uploads
# Public base URL for uploaded files (empty = serve from /uploads)
STORAGE_BASE_URL=

# Rate limiting (see src/middleware/rateLimit and src/routes/rateLimits.ts)
RATE_LIMIT_ENABLED=true
# Redis is optional: when unset, an in-memory limiter is used
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PUBLIC_WINDOW=60000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_SENSITIVE_WINDOW=60000
RATE_LIMIT_SENSITIVE_MAX=20
RATE_LIMIT_AUTH_WINDOW=60000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_EXTERNAL_WINDOW=60000
RATE_LIMIT_EXTERNAL_MAX=100

# Enterprise multi-tenancy
# single = one enterprise (DEFAULT_ENTERPRISE_ID), multi = isolated tenants
ENTERPRISE_MODE=multi
DEFAULT_ENTERPRISE_ID=

# Content review (see src/config/contentReviewConfig.ts)
CONTENT_REVIEW_ENABLED=true
CONTENT_REVIEW_STRICT_MODE=true
CONTENT_REVIEW_TIMEOUT=5000
# Optional path to a custom review plugin module loaded at runtime
CUSTOM_REVIEW_PLUGIN_PATH=
# Danger: skip individual review checks (never enable in production)
SKIP_MALICIOUS_CODE_CHECK=false
SKIP_SENSITIVE_INFO_CHECK=false
SKIP_FORMAT_VALIDATION=false

# Initial super admin bootstrap (created once on first startup)
INITIAL_SUPER_ADMIN_USERNAME=admin
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=YourSecurePassword123!

# Logging (winston level: error|warn|info|debug)
LOG_LEVEL=info
