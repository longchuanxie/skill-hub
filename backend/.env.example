# Server Configuration
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/skillhub

# CORS
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Email Configuration (for sending invitations)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password_or_app_password

# Frontend URL (for invitation links)
FRONTEND_URL=http://localhost:5173

# Initial Super Admin Configuration
# 系统首次部署时，通过以下环境变量设置初始超级管理员账户
# 建议在生产环境中使用强密码，并在首次登录后立即修改
INITIAL_SUPER_ADMIN_USERNAME=admin
INITIAL_SUPER_ADMIN_EMAIL=admin@example.com
INITIAL_SUPER_ADMIN_PASSWORD=YourSecurePassword123!

# Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# Enterprise Configuration (optional)
ENTERPRISE_MODE=multi
DEFAULT_ENTERPRISE_ID=
